{
  "name": "WF3 – Sales Cold Email Agent",
  "nodes": [
    {
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Every 3 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Get All Leads",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "app0bWNSJs9TYcFmM",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "returnAll": true,
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Pick One New Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Safety guarantee: process AT MOST one lead per execution.\n// Only leads with Status === 'New' are eligible (never re-emails Contacted/Replied).\nconst news = $input.all().filter(i => (i.json.Status || '') === 'New');\n\nif (news.length === 0) {\n  // Empty DB or no pending leads -> stop the workflow gracefully.\n  return [];\n}\n\n// Return exactly one lead.\nreturn [ news[0] ];"
      }
    },
    {
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "Generate Sales Email",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        880,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "אתה נציג מכירות של חברת אלקטרוניקה ישראלית קטנה. כתוב אימייל מכירה קר, קצר, מנומס ומותאם אישית, בעברית תקנית. פנה ללקוח בשמו, והזכר את שם החברה שלו אם קיים. הצג בקצרה איך מוצרי האלקטרוניקה שלנו יכולים לעזור לעסק שלו. אורך: 4 עד 6 שורות. אל תמציא מחירים, מבצעים, אחוזי הנחה או נתונים ספציפיים. סיים בקריאה עדינה לפעולה ובחתימה: 'בברכה, צוות המכירות'. החזר אך ורק את גוף האימייל, בלי שורת נושא ובלי הסברים."
            },
            {
              "role": "user",
              "content": "=שם הליד: {{ $json.Name }}\nחברה: {{ $json.Company }}\nאימייל: {{ $json.Email }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "Send Cold Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Pick One New Lead').item.json.Email }}",
        "subject": "={{ 'הצעה מיוחדת עבור ' + ($('Pick One New Lead').item.json.Company || 'העסק שלך') }}",
        "emailType": "text",
        "message": "={{ $json.message.content }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "Mark Lead Contacted",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "app0bWNSJs9TYcFmM",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Pick One New Lead').item.json.id }}",
            "Status": "Contacted"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable Personal Access Token account"
        }
      }
    }
  ],
  "connections": {
