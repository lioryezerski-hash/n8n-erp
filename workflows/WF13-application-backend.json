    {
      "id": "d0e1f2a3-0013-0013-0013-000000000041",
      "name": "Calculate Metrics (Chat)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        780
      ],
      "parameters": {
        "jsCode": "// Deterministic metrics BEFORE OpenAI (same rules as WF9). OpenAI only phrases the answer.\nconst invoices = $input.all().map(i => i.json).filter(i => i.id && (i.Status || '') !== 'Error');\nconst num = v => Number(v) || 0;\nconst invoiceCount = invoices.length;\nconst totalRevenue = Math.round(invoices.reduce((s, i) => s + num(i.Total), 0) * 100) / 100;\nconst totalVat = Math.round(invoices.reduce((s, i) => s + num(i.VatAmount), 0) * 100) / 100;\nconst paidAmount = Math.round(invoices.filter(i => (i.Status || '') === 'Paid').reduce((s, i) => s + num(i.Total), 0) * 100) / 100;\nconst unpaidAmount = Math.round((totalRevenue - paidAmount) * 100) / 100;\nreturn [{ json: { invoiceCount, totalRevenue, totalVat, paidAmount, unpaidAmount, currency: 'ILS' } }];"
      }
    },
    {
      "id": "d0e1f2a3-0013-0013-0013-000000000042",
      "name": "Generate Chat Answer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1040,
        780
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "אתה עוזר ניהולי של בעל עסק אלקטרוניקה. ענה בעברית בלבד, בקצרה וברור. הסתמך אך ורק על המספרים שסופקו לך בהודעת המשתמש. אל תמציא נתונים ואל תשנה מספרים. הצג סכומים כספיים עם הסימן ₪. אם המשתמש שאל על נתון שאינו מופיע בנתונים שסופקו, אמור בפירוש שאין לך אותו."
            },
            {
              "role": "user",
              "content": "=שאלת המשתמש: {{ $('Webhook').item.json.body.message }}\n\nנתונים עסקיים (מחושבים מראש בקוד, אמת ואל תשנה):\nמספר חשבוניות: {{ $json.invoiceCount }}\nסך הכנסות (כולל מע״מ): {{ $json.totalRevenue }} ₪\nסך מע״מ: {{ $json.totalVat }} ₪\nסכום ששולם: {{ $json.paidAmount }} ₪\nסכום שטרם שולם: {{ $json.unpaidAmount }} ₪"
            }
          ]
        },
        "options": {
          "temperature": 0.3
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
