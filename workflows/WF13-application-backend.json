    {
      "id": "d0e1f2a3-0013-0013-0013-000000000016",
      "name": "Build Dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        120
      ],
      "parameters": {
        "jsCode": "// KPIs from the four active tables. Filters out empty placeholder items (no id) so an empty DB is safe.\nconst invoices = $('Get Invoices (Dashboard)').all().map(i => i.json).filter(i => i.id && (i.Status || '') !== 'Error');\nconst leads = $('Get Leads (Dashboard)').all().map(i => i.json).filter(i => i.id);\nconst tasks = $('Get Tasks (Dashboard)').all().map(i => i.json).filter(i => i.id);\nconst num = v => Number(v) || 0;\n\nconst now = new Date();\nconst ym = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');\nconst monthlyRevenue = Math.round(invoices.filter(i => {\n  const d = new Date(i.Created);\n  return !isNaN(d.getTime()) && (d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0')) === ym;\n}).reduce((s, i) => s + num(i.Total), 0) * 100) / 100;\n\nconst openInvoices = invoices.filter(i => (i.Status || '') !== 'Paid').length;\n\nconst leadsByStatus = {};\nfor (const l of leads) { const s = l.Status || 'Unknown'; leadsByStatus[s] = (leadsByStatus[s] || 0) + 1; }\n\nconst tasksByStatus = {};\nfor (const t of tasks) { const s = t.Status || 'Unknown'; tasksByStatus[s] = (tasksByStatus[s] || 0) + 1; }\n\nreturn [{ json: { ok: true, action: 'dashboard', currency: 'ILS', kpis: { monthlyRevenue, openInvoices, invoiceCount: invoices.length, leadsByStatus, taskCount: tasks.length, tasksByStatus } } }];"
      }
