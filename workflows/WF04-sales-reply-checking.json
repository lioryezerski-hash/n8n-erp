    {
      "id": "d4e5f6a7-0004-0004-0004-000000000005",
      "name": "Match Replies To Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Match unread Gmail messages to leads that were previously contacted (Status === 'Contacted').\n// Only those leads move to 'Replied'. Idempotent: a lead already 'Replied' will not match again.\nconst emails = $('Aggregate Emails').first().json.data || [];\nconst leads = $input.all().map(i => i.json);\nconst contacted = leads.filter(l => (l.Status || '') === 'Contacted');\n\nconst extract = (s) => {\n  if (!s) return '';\n  const m = String(s).match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/);\n  return m ? m[0].toLowerCase() : '';\n};\n\nconst seen = new Set();\nconst results = [];\n\nfor (const e of emails) {\n  const from = extract(e.From || e.from || e.sender || (e.headers && e.headers.from) || '');\n  if (!from || seen.has(from)) continue;\n\n  const lead = contacted.find(l => (l.Email || '').trim().toLowerCase() === from);\n  if (lead) {\n    seen.add(from);\n    results.push({ json: { id: lead.id, Name: lead.Name, Email: lead.Email } });\n  }\n}\n\n// If no replies matched, returns [] and the workflow ends without any update.\nreturn results;"
      }
    },
    {
      "id": "d4e5f6a7-0004-0004-0004-000000000006",
      "name": "Mark Lead Replied",
      "type": "n8n-nodes-base.airtable",
