    {
      "id": "c9d0e1f2-0009-0009-0009-000000000010",
      "name": "Calculate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        200
      ],
      "parameters": {
        "jsCode": "// Deterministic metrics. OpenAI never calculates numbers, it only phrases the answer.\nconst num = v => Number(v) || 0;\nconst r2 = v => Math.round(v * 100) / 100;\nconst invoices = $('Get Invoices').all().map(i => i.json).filter(i => i.id && (i.Status || '') !== 'Error');\nconst leads = $('Get Leads').all().map(i => i.json).filter(i => i.id);\nconst tasks = $('Get Tasks').all().map(i => i.json).filter(i => i.id);\n\nconst now = new Date();\nconst ym = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');\nconst inMonth = i => { const d = new Date(i.Created); return !isNaN(d.getTime()) && (d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0')) === ym; };\n\nconst totalRevenue = r2(invoices.reduce((s, i) => s + num(i.Total), 0));\nconst totalVat = r2(invoices.reduce((s, i) => s + num(i.VatAmount), 0));\nconst paidAmount = r2(invoices.filter(i => (i.Status || '') === 'Paid').reduce((s, i) => s + num(i.Total), 0));\nconst monthlyRevenue = r2(invoices.filter(inMonth).reduce((s, i) => s + num(i.Total), 0));\n\nconst countBy = (rows) => rows.reduce((m, r) => { const s = r.Status || 'Unknown'; m[s] = (m[s] || 0) + 1; return m; }, {});\n\nreturn [{ json: {\n  question: $('Manager Message').first().json.message.text || '',\n  metrics: {\n    currency: 'ILS',\n    invoiceCount: invoices.length,\n    openInvoices: invoices.filter(i => (i.Status || '') !== 'Paid').length,\n    totalRevenue, totalVat, paidAmount,\n    unpaidAmount: r2(totalRevenue - paidAmount),\n    monthlyRevenue,\n    leadCount: leads.length, leadsByStatus: countBy(leads),\n    taskCount: tasks.length, tasksByStatus: countBy(tasks)\n  }\n} }];"
      }
    },
