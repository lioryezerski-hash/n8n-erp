        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "אתה עוזר ניהולי של בעל עסק אלקטרוניקה. ענה בעברית, בקצרה ובבירור. השתמש אך ורק במספרים שמופיעים בנתונים שנשלחים אליך, והעתק אותם כפי שהם. אל תחשב, אל תעגל ואל תמציא מספרים. סכומים כספיים הם בשקלים (₪). אם השאלה דורשת מידע שלא מופיע בנתונים, אמור זאת במפורש."
            },
            {
              "role": "user",
              "content": "=שאלת המנהל: {{ $json.question }}\n\nנתונים עסקיים (מחושבים מראש, אין לשנות):\n{{ JSON.stringify($json.metrics, null, 2) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
