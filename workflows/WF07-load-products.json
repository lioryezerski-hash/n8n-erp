    {
      "id": "a7b8c9d0-0007-0007-0007-000000000003",
      "name": "Build Product Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Convert each Airtable product row into a compact text representation for embedding.\n// Handles an empty Products table: returns [] so nothing is inserted (no error).\nconst results = [];\n\nfor (const item of $input.all()) {\n  const p = item.json;\n\n  const text =\n    `Name: ${p.Name ?? ''}\\n` +\n    `Category: ${p.Category ?? ''}\\n` +\n    `Price: ${p.Price ?? ''}\\n` +\n    `Description: ${p.Description ?? ''}\\n` +\n    `InStock: ${p.InStock ?? ''}`;\n\n  results.push({ json: { text, productName: p.Name ?? '' } });\n}\n\nreturn results;"
      }
    },
    {
      "id": "a7b8c9d0-0007-0007-0007-000000000004",
      "name": "Insert Products Into Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
