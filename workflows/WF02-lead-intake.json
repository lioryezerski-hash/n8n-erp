    {
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Evaluate Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        220
      ],
      "parameters": {
        "jsCode": "// Compare the newly created lead against every existing lead by Email.\n// Robust to an empty Leads table: if only the new record exists, it is not a duplicate.\nconst current = $('New Lead Trigger').first().json;\nconst all = $input.all();\n\nconst currentEmail = (current.Email || '').trim().toLowerCase();\n\nconst duplicates = all.filter(m =>\n  m.json.id !== current.id &&\n  (m.json.Email || '').trim().toLowerCase() === currentEmail\n);\n\nreturn [{\n  json: {\n    id: current.id,\n    Name: current.Name,\n    Email: current.Email,\n    isDuplicate: duplicates.length > 0\n  }\n}];"
      }
    },
