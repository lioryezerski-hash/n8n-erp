      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-amount",
              "leftValue": "={{ $json.Amount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "cond-customer",
              "leftValue": "={{ $json.CustomerId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Calculate VAT and Total",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "jsCode": "// Deterministic VAT calculation. OpenAI is NEVER used for numbers.\nconst VAT_RATE = 0.18;\nconst results = [];\n\nfor (const item of $input.all()) {\n  const amount = Number(item.json.Amount);\n\n  // Round to 2 decimals\n  const vatAmount = Math.round(amount * VAT_RATE * 100) / 100;\n  const total = Math.round(amount * (1 + VAT_RATE) * 100) / 100;\n\n  results.push({\n    json: {\n      id: item.json.id,          // Airtable record id (needed for the update)\n      InvoiceNumber: item.json.InvoiceNumber,\n      CustomerId: item.json.CustomerId,\n      Amount: amount,\n      VatAmount: vatAmount,\n      Total: total\n    }\n  });\n}\n\nreturn results;"
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Update Invoice as Validated",
